# Copy to untracked `.env` at the monorepo root (or export in the shell).
# Loaded automatically by:
#   - `pnpm dev` / scripts/dev-stack.mjs (root `.env`)
#   - `@okf-wiki/server` main (root `.env`, then packages/server/.env)
# Process environment always wins — file values never override existing keys.
# Secrets never go in workspace.json.

# OpenAI and OpenAI-compatible Chat Completions (Pi / OpenAI-compatible gateway).
# Base URL must be the API root (usually ends with /v1).
# Required for live produce (default). Missing credentials fail clearly.
OPENAI_API_KEY=replace-me
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_BASE_URL=http://127.0.0.1:8000/v1

# Optional: no-LLM pipeline smoke only (tests/e2e/dev smoke). Default is live.
# Do not set this for normal operator use.
# OKF_WIKI_AGENT_MODE=fixture

# Local server (defaults shown)
# OKF_WIKI_HOST=127.0.0.1
# OKF_WIKI_PORT=8787
# OKF_WIKI_HOME=~/.okf-wiki

# Server runtime logging (process/ops — not Pi attempt transcripts)
# Default file: $OKF_WIKI_HOME/logs/server.jsonl
#   Linux/macOS: ~/.okf-wiki/logs/server.jsonl
#   Windows:     %USERPROFILE%\.okf-wiki\logs\server.jsonl
# OKF_LOG_LEVEL=debug
# OKF_LOG_PRETTY=1
# OKF_LOG_DIR=
# OKF_LOG_FILE=
# OKF_LOG_HTTP=1
# OKF_LOG_HTTP_HEALTH=0
# Set OKF_LOG_FILE=0 to disable the file sink (stdout only).

# LAN access (explicit opt-in)
# OKF_WIKI_ALLOW_LAN=1
# OKF_WIKI_HOST=0.0.0.0
# Web: open http://<any-host-ip>:5173 — client uses same-origin /api (Vite proxy).
# Only set VITE_API_BASE if the API is NOT proxied on the same origin:
# VITE_API_BASE=http://host:8787
# VITE_API_PROXY_TARGET=http://127.0.0.1:8787
