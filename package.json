{
  "name": "open-okf-wiki-wiki-agent-kit",
  "private": true,
  "version": "0.1.0-dev",
  "description": "Pi extension and deterministic core for source-grounded repository wikis",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:pi-wiki-agent": "pnpm --filter @okf-wiki/pi-wiki-agent build",
    "test": "pnpm --filter @okf-wiki/wiki-agent-kit test && pnpm --filter @okf-wiki/pi-wiki-agent test",
    "typecheck": "pnpm --filter @okf-wiki/pi-wiki-agent typecheck"
  }
}
