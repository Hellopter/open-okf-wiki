{
  "name": "okf-wiki",
  "private": true,
  "version": "0.2.0-dev",
  "description": "Generate source-grounded Markdown Wikis from local Git repositories (Pi agent harness + local Web UI).",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": "22.23.x"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "build:libs": "tsc -b tsconfig.libs.json --pretty false",
    "dev:libs": "tsc -b tsconfig.libs.json --watch --preserveWatchOutput --pretty false",
    "test": "pnpm -r run test",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "biome check --write --formatter-enabled=true --linter-enabled=false --assist-enabled=true .",
    "format:check": "biome check --formatter-enabled=true --linter-enabled=false --assist-enabled=true .",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run check:architecture",
    "check:architecture": "node scripts/check-architecture.mjs",
    "test:e2e": "pnpm --filter @okf-wiki/web test:e2e",
    "dev": "node scripts/dev-stack.mjs --profile=full",
    "dev:full": "node scripts/dev-stack.mjs --profile=full",
    "dev:stack": "node scripts/dev-stack.mjs --profile=full",
    "dev:web": "node scripts/dev-stack.mjs --profile=web",
    "dev:server": "node scripts/dev-stack.mjs --profile=server",
    "dev:stack:parallel": "concurrently -k -n libs,server,web -c cyan,green,yellow \"pnpm run dev:libs\" \"pnpm --filter @okf-wiki/server dev\" \"pnpm --filter @okf-wiki/web dev\""
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.2.4",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0"
  }
}
