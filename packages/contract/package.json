{
  "name": "@okf-wiki/contract",
  "version": "0.2.0-dev",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./session": {
      "types": "./dist/session.d.ts",
      "import": "./dist/session.js"
    },
    "./wiki-runs": {
      "types": "./dist/wiki-runs-api.d.ts",
      "import": "./dist/wiki-runs-api.js"
    },
    "./coverage": {
      "types": "./dist/coverage.d.ts",
      "import": "./dist/coverage.js"
    },
    "./stream-server": {
      "types": "./dist/stream-server.d.ts",
      "import": "./dist/stream-server.js"
    },
    "./workspace": {
      "types": "./dist/workspace-api.d.ts",
      "import": "./dist/workspace-api.js"
    },
    "./pi-attempt": {
      "types": "./dist/pi-attempt.d.ts",
      "import": "./dist/pi-attempt.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "tsc -b tsconfig.json --force && node --test $(find src -name '*.test.ts' | sed 's|^src/|dist/|; s|\\.ts$|.js|' | sort)"
  },
  "dependencies": {
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.9.3"
  }
}
