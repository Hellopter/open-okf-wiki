{
  "name": "@okf-wiki/pi-wiki-agent",
  "version": "0.1.0-dev",
  "private": true,
  "type": "module",
  "description": "Pi extension for persistent-session, source-grounded OKF repository Wiki production",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "extensions/",
    "scripts/",
    "src/",
    "README.md"
  ],
  "scripts": {
    "prebuild": "pnpm --filter @okf-wiki/wiki-agent-kit build",
    "build": "node ./scripts/run-tsc.mjs -p tsconfig.json",
    "check": "node ./scripts/run-tsc.mjs -p tsconfig.json --noEmit",
    "pretypecheck": "pnpm --filter @okf-wiki/wiki-agent-kit build",
    "typecheck": "node ./scripts/run-tsc.mjs -p tsconfig.json --noEmit",
    "test": "pnpm build && node ./scripts/run-tests.mjs",
    "verify:pi": "node scripts/verify-pi-install.mjs",
    "pack:check": "pnpm pack --dry-run"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi",
    "wiki",
    "repository-wiki"
  ],
  "pi": {
    "extensions": [
      "./extensions/wiki.ts"
    ]
  },
  "dependencies": {
    "@okf-wiki/wiki-agent-kit": "workspace:*"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.82.1",
    "@earendil-works/pi-coding-agent": "^0.82.1",
    "@earendil-works/pi-tui": "^0.82.1",
    "@types/node": "^22.10.2",
    "typebox": "*",
    "typescript": "^5.7.3"
  }
}
