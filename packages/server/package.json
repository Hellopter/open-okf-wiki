{
  "name": "@okf-wiki/server",
  "version": "0.2.0-dev",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --experimental-strip-types --watch src/main.ts",
    "start": "node --experimental-strip-types src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings 0",
    "build": "tsc -p tsconfig.json",
    "test": "OKF_LOG_FILE=0 OKF_LOG_LEVEL=silent OKF_LOG_PRETTY=0 node --experimental-strip-types --test --test-concurrency=1 $(find src -name '*.test.ts' | sort)"
  },
  "dependencies": {
    "@okf-wiki/agent": "workspace:*",
    "@okf-wiki/contract": "workspace:*",
    "@okf-wiki/core": "workspace:*",
    "@okf-wiki/workflow": "workspace:*",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.9.3"
  }
}
