{
  "java-tests": {
    "label": "Java tests",
    "patterns": [
      "src/test/**",
      "**/src/test/**",
      "**/*Test.java",
      "**/*Tests.java",
      "**/*IT.java",
      "**/*ITCase.java"
    ]
  },
  "java-generated": {
    "label": "Java generated sources",
    "patterns": [
      "**/generated/**",
      "**/generated-sources/**",
      "**/generated-test-sources/**"
    ]
  },
  "java-ide": {
    "label": "Java IDE metadata",
    "patterns": [
      ".settings/**",
      ".classpath",
      ".project",
      "bin/**",
      "*.iml"
    ]
  },
  "js-tests": {
    "label": "JS/TS tests",
    "patterns": [
      "**/*.test.ts",
      "**/*.test.tsx",
      "**/*.test.js",
      "**/*.spec.ts",
      "**/*.spec.tsx",
      "**/*.spec.js",
      "**/__tests__/**",
      "**/__mocks__/**"
    ]
  },
  "python-tests": {
    "label": "Python tests",
    "patterns": [
      "tests/**",
      "**/tests/**",
      "test/**",
      "**/test/**",
      "**/test_*.py",
      "**/*_test.py"
    ]
  }
}
