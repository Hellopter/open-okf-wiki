{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://okf.wiki/schemas/checkpoint.schema.json",
  "title": "Wiki authoritative checkpoint (v2)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "runId", "phase", "status", "createdAt", "inputCheckpointDigests", "artifacts", "checkpointDigest"],
  "properties": {
    "version": { "const": 2 },
    "runId": { "type": "string", "minLength": 1 },
    "phase": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "status": { "enum": ["complete", "blocked"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "inputCheckpointDigests": {
      "type": "array",
      "items": { "type": "string", "pattern": "^(sha256:)?[a-f0-9]{64}$" }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "owner", "path", "dependsOn", "digest"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 200 },
          "type": { "type": "string", "minLength": 1, "maxLength": 100 },
          "owner": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
          "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$" },
          "dependsOn": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "coverageUnitIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "pagePaths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "summary": { "type": "string", "maxLength": 6000 },
          "openQuestions": { "type": "array", "items": { "type": "string", "maxLength": 2000 } },
          "digest": { "type": "string", "pattern": "^(sha256:)?[a-f0-9]{64}$" }
        }
      }
    },
    "summary": { "type": "string", "maxLength": 6000 },
    "openQuestions": { "type": "array", "items": { "type": "string", "maxLength": 2000 } },
    "reason": { "type": "string", "maxLength": 6000 },
    "checkpointDigest": { "type": "string", "pattern": "^(sha256:)?[a-f0-9]{64}$" }
  }
}
