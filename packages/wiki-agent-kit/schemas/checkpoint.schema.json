{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://okf.wiki/schemas/checkpoint.schema.json",
  "title": "Wiki authoritative checkpoint (v3)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "runId", "phase", "status", "createdAt", "artifacts", "checkpointDigest"],
  "properties": {
    "version": { "const": 3 },
    "runId": { "type": "string", "minLength": 1 },
    "phase": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "status": { "const": "complete" },
    "createdAt": { "type": "string", "format": "date-time" },
    "predecessorDigest": { "type": "string", "pattern": "^(sha256:)?[a-f0-9]{64}$" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "path", "digest"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 200 },
          "type": { "type": "string", "minLength": 1, "maxLength": 100 },
          "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$" },
          "coverageUnitIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "digest": { "type": "string", "pattern": "^(sha256:)?[a-f0-9]{64}$" }
        }
      }
    },
    "checkpointDigest": { "type": "string", "pattern": "^(sha256:)?[a-f0-9]{64}$" }
  }
}
