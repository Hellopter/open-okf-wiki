{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://okf.wiki/schemas/defects.schema.json",
  "title": "Wiki candidate review defects",
  "type": "object",
  "required": ["clean", "defects"],
  "properties": {
    "clean": { "type": "boolean" },
    "defects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "code", "issue"],
        "properties": {
          "severity": { "enum": ["blocking", "major", "minor"] },
          "code": { "type": "string", "minLength": 1 },
          "issue": { "type": "string", "minLength": 1 },
          "path": { "type": "string" }
        }
      }
    }
  }
}
