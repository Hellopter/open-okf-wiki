{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://okf.wiki/schemas/handoff-proposal.schema.json",
  "title": "Wiki handoff proposal (v2)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "phase", "inputCheckpointDigests", "producer", "artifacts"],
  "properties": {
    "version": { "const": 2 },
    "phase": { "$ref": "#/$defs/phase" },
    "inputCheckpointDigests": {
      "type": "array",
      "items": { "$ref": "#/$defs/digest" }
    },
    "producer": { "$ref": "#/$defs/owner" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/proposedArtifact" }
    },
    "summary": { "type": "string", "maxLength": 6000 },
    "openQuestions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    },
    "status": { "enum": ["complete", "blocked"] },
    "reason": { "type": "string", "maxLength": 6000 }
  },
  "$defs": {
    "phase": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "digest": { "type": "string", "pattern": "^(sha256:)?[a-f0-9]{64}$" },
    "owner": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
    },
    "proposedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "owner", "path", "dependsOn"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "type": { "type": "string", "minLength": 1, "maxLength": 100 },
        "owner": { "$ref": "#/$defs/owner" },
        "path": { "$ref": "#/$defs/relativePath" },
        "dependsOn": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "coverageUnitIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "pagePaths": { "type": "array", "items": { "$ref": "#/$defs/relativePath" } },
        "summary": { "type": "string", "maxLength": 6000 },
        "openQuestions": { "type": "array", "items": { "type": "string", "maxLength": 2000 } }
      }
    }
  }
}
