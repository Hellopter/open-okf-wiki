{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://okf.wiki/schemas/spec.schema.json",
  "title": "Wiki run specification (v2)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "pages", "pageAssignments"],
  "properties": {
    "version": { "const": 2 },
    "title": { "type": "string" },
    "overviewPath": { "type": "string" },
    "wikiLanguage": { "type": "string", "enum": ["en", "zh"] },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\.\\.)[^\\\\]+\\.md$" },
          "type": { "type": "string" },
          "title": { "type": "string" },
          "question": { "type": "string" },
          "critical": { "type": "boolean" },
          "coverageUnitIds": { "type": "array", "items": { "type": "string" } },
          "owner": { "$ref": "#/$defs/owner" }
        }
      }
    },
    "pageAssignments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pagePath", "owner", "role", "coverageUnitIds", "dependsOn"],
        "properties": {
          "pagePath": { "$ref": "#/$defs/candidatePath" },
          "owner": { "$ref": "#/$defs/owner" },
          "role": { "enum": ["domain", "integration"] },
          "coverageUnitIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "dependsOn": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "sourceIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "contractIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "terms": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "domains": { "type": "array", "items": { "type": "object" } },
    "coverageCancellations": { "$ref": "#/$defs/cancellations" },
    "crossSourceFlowCancellation": {
      "type": "object",
      "properties": { "cancelled": { "const": true }, "reason": { "type": "string", "minLength": 1 } },
      "required": ["cancelled", "reason"]
    }
  },
  "$defs": {
    "candidatePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+\\.md$"
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "cancellations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "coverageUnitId": { "type": "string", "minLength": 1 },
          "cancelled": { "const": true },
          "reason": { "type": "string", "minLength": 1 }
        },
        "required": ["coverageUnitId", "cancelled", "reason"]
      }
    }
  }
}
