{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://okf.wiki/schemas/spec.schema.json",
  "title": "Wiki run specification",
  "type": "object",
  "required": ["pages"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string" },
    "overviewPath": { "type": "string" },
    "wikiLanguage": { "type": "string" },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "type",
          "title",
          "question",
          "critical",
          "audiences",
          "requiredSections",
          "knowledgeIds",
          "evidenceIds",
          "coverageUnitIds"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*\\.\\.)[^\\\\]+\\.md$"
          },
          "type": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "question": { "type": "string", "minLength": 1 },
          "critical": { "type": "boolean" },
          "audiences": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "requiredSections": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "knowledgeIds": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "evidenceIds": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "coverageUnitIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "relatedPagePaths": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": true
      }
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "coverageUnitIds": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "coverageCancellations": { "$ref": "#/$defs/cancellations" },
    "crossSourceFlowCancellation": {
      "type": "object",
      "properties": {
        "cancelled": { "const": true },
        "reason": { "type": "string", "minLength": 1 }
      },
      "required": ["cancelled", "reason"]
    }
  },
  "$defs": {
    "cancellations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "coverageUnitId": { "type": "string", "minLength": 1 },
          "cancelled": { "const": true },
          "reason": { "type": "string", "minLength": 1 }
        },
        "required": ["coverageUnitId", "cancelled", "reason"]
      }
    }
  }
}
