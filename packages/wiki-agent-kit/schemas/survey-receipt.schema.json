{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://okf.wiki/schemas/survey-receipt.schema.json",
  "title": "Wiki survey receipt (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "coverageUnit",
    "status",
    "purpose",
    "summary",
    "entryPoints",
    "modules",
    "runtimeFlows",
    "contracts",
    "evidence",
    "plannerHints",
    "openQuestions"
  ],
  "properties": {
    "version": { "const": 1 },
    "kind": { "const": "survey-receipt" },
    "coverageUnit": { "$ref": "#/$defs/coverageUnit" },
    "status": { "enum": ["ok", "failed", "skipped"] },
    "purpose": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "entryPoints": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "modules": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "runtimeFlows": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "contracts": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
    "plannerHints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domains", "flows"],
      "properties": {
        "domains": { "type": "array", "items": { "$ref": "#/$defs/hint" } },
        "flows": { "type": "array", "items": { "$ref": "#/$defs/flowHint" } }
      }
    },
    "openQuestions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "insufficiency": { "$ref": "#/$defs/insufficiency" },
    "relatedCoverageUnitIds": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "coverageUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "sourceId", "path", "label"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["source", "surface"] },
        "sourceId": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "summary"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "evidenceIds": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "startLine", "endLine", "summary"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "pattern": "^sources/" },
        "startLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "hint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "summary"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "evidenceIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "coverageUnitIds": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "flowHint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "summary"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "evidenceIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "coverageUnitIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "crossSource": { "type": "boolean" }
      }
    },
    "insufficiency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "retryable", "reason"],
      "properties": {
        "code": { "enum": ["rate_limited", "timeout", "snapshot_missing", "access_denied", "unsupported", "no_evidence", "other"] },
        "retryable": { "type": "boolean" },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
