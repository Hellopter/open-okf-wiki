{
  "name": "@okf-wiki/workflow",
  "version": "0.2.0-dev",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "tsc -b tsconfig.json --force && node --test $(find src -name '*.test.ts' | sed 's|^src/|dist/|; s|\\.ts$|.js|' | sort)"
  },
  "dependencies": {
    "@okf-wiki/contract": "workspace:*",
    "@okf-wiki/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  }
}
